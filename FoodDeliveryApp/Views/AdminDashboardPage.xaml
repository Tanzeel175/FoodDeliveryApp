<Page x:Class="FoodDeliveryApp.Views.AdminDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="📋 Order Management"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#4A121E"/>
            <TextBlock x:Name="PendingCountText"
                       Text="0 orders in queue"
                       FontSize="14"
                       Foreground="#555555"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Action Buttons Row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,16">
            <Button x:Name="ProcessNextButton"
                    Content="⚡ Process Next Order"
                    FontSize="15"
                    Padding="24,10"
                    Click="ProcessNext_Click"
                    Margin="0,0,12,0"/>

            <Button x:Name="RefreshButton"
                    Content="🔄 Refresh"
                    FontSize="14"
                    Padding="20,8"
                    Background="#7A1A29"
                    Click="Refresh_Click"/>
        </StackPanel>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyPanel"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="✅"
                       FontSize="64"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="No pending orders"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#4A121E"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="All orders have been processed. Great job!"
                       FontSize="14"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Orders List -->
        <ScrollViewer x:Name="OrdersScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFFFFF"
                                CornerRadius="15"
                                Margin="0,0,0,10"
                                Padding="0"
                                ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#000000" Opacity="0.1"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left accent strip (red for first/next item) -->
                                <Border Grid.Column="0" Background="#E53935"/>

                                <!-- Order Content -->
                                <Grid Grid.Column="1" Margin="16,14,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Order ID & Status -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                        <Border Background="#FDF8F5" BorderBrush="#E53935" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="#E53935">
                                                <Run Text="Order #"/>
                                                <Run Text="{Binding Id, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                        <Border CornerRadius="8" Padding="10,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FF8F00"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Total -->
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="#4CAF50"
                                               VerticalAlignment="Center">
                                        <Run Text="Rs "/>
                                        <Run Text="{Binding TotalAmount, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                    </TextBlock>

                                    <!-- Customer -->
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               FontSize="14" Foreground="#777777"
                                               Margin="0,8,0,0">
                                        <Run Text="👤 Customer: " FontWeight="SemiBold"/>
                                        <Run Text="{Binding CustomerName, Mode=OneWay}" Foreground="#4A121E" FontWeight="Bold"/>
                                    </TextBlock>

                                    <!-- Items -->
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                               FontSize="13" Foreground="#777777"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0">
                                        <Run Text="📦 Items: "/>
                                        <Run Text="{Binding Items, Mode=OneWay}" Foreground="#4A121E"/>
                                    </TextBlock>

                                    <!-- Time -->
                                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                                               FontSize="12" Foreground="#999999"
                                               Margin="0,6,0,0">
                                        <Run Text="🕐 "/>
                                        <Run Text="{Binding PlacedAt, StringFormat='{}{0:MMM dd, yyyy  hh:mm tt}', Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
