<Page x:Class="FoodDeliveryApp.Views.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton"
                    Grid.Column="0"
                    Content="← Back"
                    FontSize="14"
                    Padding="16,6"
                    Background="#7A1A29"
                    Click="BackToMenu_Click"
                    VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
                       Text="🛒 Your Cart"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#4A121E"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </Grid>

        <!-- Empty Cart Message -->
        <StackPanel x:Name="EmptyCartPanel"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="😔"
                       FontSize="64"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Your cart is empty"
                       FontSize="22" FontWeight="SemiBold"
                       Foreground="#4A121E"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Browse our menu and add some delicious items!"
                       FontSize="14"
                       Foreground="#555555"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,20"/>
            <Button Content="🍽️  Browse Menu"
                    FontSize="15"
                    Height="44"
                    Width="200"
                    Click="BackToMenu_Click"/>
        </StackPanel>

        <!-- Cart Items List -->
        <ScrollViewer x:Name="CartScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CartItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#4A121E"
                                CornerRadius="15"
                                Margin="0,0,0,10"
                                Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#000000" Opacity="0.2"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Product Info -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Product.Name}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Foreground="#B0BEC5" FontSize="13" Margin="0,2,0,0">
                                        <Run Text="{Binding Variation.Name, Mode=OneWay}"/>
                                        <Run Text=" — Rs "/>
                                        <Run Text="{Binding Variation.Price, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Quantity -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock Text="Qty: "
                                               Foreground="#B0BEC5" FontSize="14"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#7A1A29" CornerRadius="8"
                                            Padding="12,4" MinWidth="36">
                                        <TextBlock Text="{Binding Quantity}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Subtotal -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                                    <TextBlock FontSize="12" Foreground="#B0BEC5">Subtotal</TextBlock>
                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#4CAF50">
                                        <Run Text="Rs "/>
                                        <Run Text="{Binding Subtotal, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Remove Button -->
                                <Button Grid.Column="4"
                                        Content="✕"
                                        FontSize="16"
                                        Width="36" Height="36"
                                        Padding="0"
                                        Background="#C62828"
                                        Click="RemoveItem_Click"
                                        Tag="{Binding}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Section: Total + Actions -->
        <Border x:Name="BottomBar"
                Grid.Row="2"
                Background="#4A121E"
                CornerRadius="15"
                Padding="24,16"
                Margin="0,12,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="-2" Direction="90" Color="#000000" Opacity="0.3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Total -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Total" FontSize="14" Foreground="#B0BEC5"/>
                    <TextBlock x:Name="TotalText"
                               Text="Rs 0"
                               FontSize="28" FontWeight="Bold"
                               Foreground="White"/>
                </StackPanel>

                <!-- Back to Menu -->
                <Button Grid.Column="1"
                        Content="← Menu"
                        FontSize="14"
                        Padding="20,8"
                        Background="#7A1A29"
                        Click="BackToMenu_Click"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>

                <!-- Place Order -->
                <Button x:Name="PlaceOrderButton"
                        Grid.Column="2"
                        Content="🎉  Place Order"
                        FontSize="16"
                        Padding="28,10"
                        Click="PlaceOrder_Click"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
