<Window x:Class="FoodDeliveryApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodExpress - Login"
        WindowState="Maximized"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStartupLocation="CenterScreen"
        Background="#F8E6E8"
        TextElement.Foreground="#4A121E"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#4A121E" TextElement.Foreground="White">
            <Grid>
                <!-- Title & Logo -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <Image Source="/Assets/app.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FoodExpress" 
                               FontSize="14" FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderWindowControlButtonStyle}" Click="MinimizeButton_Click">
                        <Path Data="M 0,8 L 10,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource HeaderWindowControlButtonStyle}" Click="MaximizeButton_Click">
                        <Path Data="M 1,1 L 9,1 L 9,9 L 1,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource HeaderCloseWindowControlButtonStyle}" Click="CloseButton_Click">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="#4A121E"
                TextElement.Foreground="White"
                CornerRadius="15"
                Padding="40"
                MaxWidth="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MinWidth="380">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <!-- App Logo & Title -->
                <Image Source="/Assets/app.png"
                       Width="72" Height="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="FoodExpress"
                           FontSize="30" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <!-- Subtitle -->
                <TextBlock Text="Sign in to your account"
                           FontSize="14"
                           Foreground="#B0BEC5"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Username Label -->
                <TextBlock Text="Username"
                           FontSize="13"
                           Foreground="#B0BEC5"
                           Margin="0,0,0,6"/>

                <!-- Username TextBox -->
                <TextBox x:Name="UsernameTextBox"
                         Height="40"
                         Margin="0,0,0,16"/>

                <!-- Password Label -->
                <TextBlock Text="Password"
                           FontSize="13"
                           Foreground="#B0BEC5"
                           Margin="0,0,0,6"/>

                <!-- PasswordBox -->
                <PasswordBox x:Name="PasswordInput"
                             Height="40"
                             Margin="0,0,0,8"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText"
                           Text="Invalid username or password"
                           Foreground="#FF1744"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"
                           Visibility="Collapsed"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Content="Sign In"
                        Height="44"
                        FontSize="16"
                        Margin="0,10,0,0"
                        Click="LoginButton_Click"/>

                <!-- Sign Up Link -->
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0">
                    <TextBlock Text="New customer? " Foreground="#B0BEC5" FontSize="14"/>
                    <TextBlock Text="Sign Up" Foreground="#E53935" FontSize="14" FontWeight="Bold"
                               Cursor="Hand" MouseDown="SignUpLink_MouseDown"/>
                </StackPanel>
                <!-- Footer -->
                <TextBlock Text="Delicious food, delivered fast 🚀"
                           FontSize="12"
                           Foreground="#B0BEC5"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
            </ScrollViewer>
    </Grid>
</Window>
