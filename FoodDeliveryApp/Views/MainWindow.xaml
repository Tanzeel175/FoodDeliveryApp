<Window x:Class="FoodDeliveryApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoodExpress"
        WindowState="Maximized"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        WindowStartupLocation="CenterScreen"
        Background="#F8E6E8"
        TextElement.Foreground="#4A121E"
        Icon="pack://application:,,,/Assets/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        MouseLeftButtonDown="Window_MouseDown"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#4A121E" TextElement.Foreground="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.3"/>
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Title & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                    <Image Source="/Assets/app.png" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FoodExpress"
                               FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Welcome Message -->
                <TextBlock x:Name="WelcomeText"
                           Grid.Column="1"
                           Text="Welcome!"
                           FontSize="14"
                           Foreground="#B0BEC5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,3,20,0"/>

                <!-- Cart Badge (Customer Only) -->
                <Button x:Name="CartButton"
                        Grid.Column="2"
                        Click="CartButton_Click"
                        VerticalAlignment="Center"
                        Margin="0,4,12,0"
                        Padding="0"
                        Width="46" Height="46"
                        Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Cursor="Hand">
                                <Border x:Name="CartBorder"
                                        Background="Transparent"
                                        CornerRadius="23"
                                        Width="46" Height="46">
                                    <TextBlock Text="🛒"
                                               FontSize="22"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Badge -->
                                <Border x:Name="BadgeBorder"
                                        Background="#E53935"
                                        CornerRadius="10"
                                        MinWidth="20" Height="20"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Padding="4,0">
                                    <TextBlock x:Name="BadgeCount"
                                               Text="0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CartBorder" Property="Background" Value="#7A1A29"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Logout Button -->
                <Button x:Name="LogoutButton"
                        Grid.Column="3"
                        Content="Logout"
                        Click="LogoutButton_Click"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Padding="16,6"
                        Margin="0,4,15,0"
                        Background="#7A1A29"/>

                <!-- Custom Window Controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,4,0,0">
                    <Button Style="{StaticResource HeaderWindowControlButtonStyle}" Click="MinimizeButton_Click">
                        <Path Data="M 0,8 L 10,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource HeaderWindowControlButtonStyle}" Click="MaximizeButton_Click">
                        <Path Data="M 1,1 L 9,1 L 9,9 L 1,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource HeaderCloseWindowControlButtonStyle}" Click="CloseButton_Click">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Frame -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
