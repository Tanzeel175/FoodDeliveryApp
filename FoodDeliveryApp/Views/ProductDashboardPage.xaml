<Page x:Class="FoodDeliveryApp.Views.ProductDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:FoodDeliveryApp.Converters"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="← Back" 
                    Background="Transparent" BorderThickness="0" Foreground="#555555" FontSize="16"
                    VerticalAlignment="Center" Margin="0,0,15,0" Cursor="Hand"
                    Click="BackButton_Click"/>
            
            <TextBlock x:Name="CategoryTitleText" Grid.Column="1"
                       Text="🍽️ Our Menu"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#4A121E" VerticalAlignment="Center"/>
        </Grid>

        <!-- Product Grid -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10,10,20,10">
            <ItemsControl x:Name="ProductsItemsControl" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#4A121E"
                                CornerRadius="15"
                                Width="300"
                                Margin="8"
                                Padding="0"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="180"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Product Image -->
                                <Border Grid.Row="0" CornerRadius="15,15,0,0" ClipToBounds="True">
                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                           Stretch="Uniform"
                                           Height="180"/>
                                </Border>

                                <!-- Fallback colored strip if no image -->
                                <Border Grid.Row="0" CornerRadius="15,15,0,0"
                                        Background="#7A1A29"
                                        Visibility="{Binding ImagePath, Converter={StaticResource ImagePathConverter}, ConverterParameter=fallback}">
                                    <TextBlock Text="🍔" FontSize="60"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Product Info -->
                                <StackPanel Grid.Row="1" Margin="16,12,16,16">
                                    <!-- Name -->
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Description -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13"
                                               Foreground="#B0BEC5"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"
                                               Margin="0,4,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Variation Selector -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Size / Variation:" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="VariationCombo" ItemsSource="{Binding Variations}" SelectedIndex="0" Height="34"/>
                                        </StackPanel>

                                        <!-- Quantity Selector -->
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Qty:" FontSize="12" Foreground="#B0BEC5" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="QuantityCombo" SelectedIndex="0" Height="34">
                                                <ComboBoxItem Content="1"/>
                                                <ComboBoxItem Content="2"/>
                                                <ComboBoxItem Content="3"/>
                                                <ComboBoxItem Content="4"/>
                                                <ComboBoxItem Content="5"/>
                                                <ComboBoxItem Content="6"/>
                                                <ComboBoxItem Content="7"/>
                                                <ComboBoxItem Content="8"/>
                                                <ComboBoxItem Content="9"/>
                                                <ComboBoxItem Content="10"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Add to Cart Button -->
                                    <Button Content="🛒  Add to Cart"
                                            FontSize="14"
                                            Height="38"
                                            Click="AddToCart_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Bar -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="ViewCartButton"
                    Content="🛒  View Cart"
                    FontSize="15"
                    Height="44"
                    Width="200"
                    HorizontalAlignment="Right"
                    Click="ViewCart_Click"/>
        </Border>
    </Grid>
</Page>
